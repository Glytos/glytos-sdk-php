{
    "name": "glytos/glytos",
    "description": "Official Glytos server SDK for PHP.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://glytos.com",
    "keywords": ["glytos", "voice", "ai", "agent", "sdk", "api"],
    "authors": [
        { "name": "Glytos" }
    ],
    "support": {
        "docs": "https://glytos.com/en/docs",
        "issues": "https://github.com/Glytos/glytos-sdk-php/issues",
        "source": "https://github.com/Glytos/glytos-sdk-php"
    },
    "require": {
        "php": ">=8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.5",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Any PSR-18 HTTP client works; Guzzle is discovered automatically when installed.",
        "symfony/http-client": "An alternative PSR-18 client, discovered automatically when installed.",
        "illuminate/support": "Enables the Laravel service provider and Glytos facade (auto-discovered)."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Glytos\\Laravel\\GlytosServiceProvider"
            ],
            "aliases": {
                "Glytos": "Glytos\\Laravel\\Glytos"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "Glytos\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Glytos\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "minimum-stability": "stable"
}
